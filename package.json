{
  "name": "boxpdf-html",
  "version": "1.5.0",
  "mcpName": "io.github.earonesty/boxpdf-html",
  "description": "Readable HTML-to-PDF translator built on boxpdf.",
  "type": "module",
  "main": "./dist/index.cjs",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "bin": {
    "boxpdf-html": "dist/cli.js"
  },
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js",
      "require": "./dist/index.cjs"
    }
  },
  "files": [
    "dist",
    "README.md",
    "LICENSE"
  ],
  "scripts": {
    "build": "tsup",
    "test": "vitest run",
    "test:coverage": "vitest run --coverage",
    "typecheck": "tsc --noEmit",
    "compare:prince": "pnpm run build && node scripts/render-prince-reference.mjs",
    "visual:regenerate": "pnpm run build && node scripts/render-all-comparisons.mjs",
    "visual:check": "pnpm run visual:check:boxpdf",
    "visual:check:boxpdf": "pnpm run build && node scripts/check-boxpdf-baselines.mjs",
    "visual:check:prince": "pnpm run visual:regenerate && git diff --exit-code -- artifacts/*/*.png",
    "tailwind:fixture": "node scripts/build-tailwind-fixture.mjs",
    "profile:render": "pnpm run build && node scripts/render-boxpdf-profile.mjs",
    "prepublishOnly": "pnpm run typecheck && pnpm run test && pnpm run build && node scripts/prepare-publish.mjs --verify",
    "pack:release": "pnpm run typecheck && pnpm run test && pnpm run build && node scripts/prepare-publish.mjs --pack",
    "publish:release": "pnpm run typecheck && pnpm run test && pnpm run build && node scripts/prepare-publish.mjs --publish"
  },
  "keywords": [
    "pdf",
    "html",
    "css",
    "boxpdf",
    "html-to-pdf"
  ],
  "license": "MIT",
  "author": {
    "name": "Erik Aronesty",
    "email": "erik@q32.com"
  },
  "homepage": "https://github.com/earonesty/boxpdf-html#readme",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/earonesty/boxpdf-html.git"
  },
  "bugs": {
    "url": "https://github.com/earonesty/boxpdf-html/issues"
  },
  "dependencies": {
    "boxpdf": "^1.11.0",
    "css-tree": "^3.1.0",
    "parse5": "^8.0.0",
    "pdf-lib": "^1.17.1"
  },
  "devDependencies": {
    "@tailwindcss/cli": "^4.3.0",
    "@types/node": "^22.19.19",
    "@vitest/coverage-v8": "4.1.6",
    "tailwindcss": "^4.3.0",
    "tsup": "^8.5.1",
    "typescript": "^5.9.3",
    "vitest": "^4.1.6"
  },
  "engines": {
    "node": ">=20"
  },
  "publishConfig": {
    "access": "public"
  },
  "packageManager": "pnpm@10.30.3"
}
